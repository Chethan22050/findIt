rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read basic profile info; owners can read their full info
      allow read: if isAuthenticated();
      // Only user can create/update their own profile, cannot assign admin role directly
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow delete: if isAdmin();
    }

    // Lost items collection
    match /lostItems/{itemId} {
      // Anyone can browse lost listings
      allow read: if true;
      // Only authenticated users can report a lost item
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only the author or an admin can update/delete
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Found items collection
    match /foundItems/{itemId} {
      // Anyone can browse found listings
      allow read: if true;
      // Only authenticated users can report a found item
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only the finder or an admin can update/delete
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Claims collection
    match /claims/{claimId} {
      // A claim can be read by: the claimant, the item reporter, or an admin
      allow read: if isAuthenticated() && (
        resource.data.claimantId == request.auth.uid || 
        resource.data.itemOwnerId == request.auth.uid || 
        isAdmin()
      );
      // Authenticated users can submit a claim (claimantId must match auth.uid)
      allow create: if isAuthenticated() && request.resource.data.claimantId == request.auth.uid;
      // The item owner or an admin can update the claim status (Pending -> Approved/Rejected)
      allow update: if isAuthenticated() && (
        resource.data.itemOwnerId == request.auth.uid || 
        resource.data.claimantId == request.auth.uid || 
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.claimantId == request.auth.uid || isAdmin());
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Platform statistics / metrics
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
